{
  "name": "@earendil-works/pi-pipeline",
  "version": "0.1.0",
  "description": "Pipeline loop plugin for pi agent — stage-based orchestration with per-project configuration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/template','dist/template',{recursive:true})\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test"
  },
  "dependencies": {
    "ignore": "^7.0.6",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@earendil-works/pi-ai": "^0.84.3"
  },
  "files": [
    "dist"
  ],
  "pi": {
    "extensions": ["./index.ts"]
  },
  "license": "MIT"
}
